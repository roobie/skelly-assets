// A generic modern Western main battle tank of 55 to 65 t, drawn to no one design: 7.7 m of hull, 3.7 m across its
// side skirts, 2.45 m to its turret roof and 0.5 m clear of the ground. Metres in the vehicle frame.
{
  rear: -3.85, nose: 3.85, belly: 0.5, floor: 0.58, shelf: 1.22, roof: 1.6, roofTop: 1.65,
  // The lower hull's sides between the tracks, the upper hull's over them, and the skirts outside them.
  wall: 0.92, side: 1.8, skirt: 1.86,
  // The nose's tip, where the upper glacis meets the roof, and where the lower glacis meets the belly.
  noseTop: 1.0, glacisTop: 2.2, lowerGlacisX: 3.1,
  trackZ: 1.48,
  turretX: -0.3, driverX: 1.75,
  engineX: -2.3, radiatorX: -1.15,
  paint: 'paint-olive',
}
