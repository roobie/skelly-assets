local site = import 'site.libsonnet';
local one = site.one;
local pair = site.pair;
local s = import 'jackknifed_lorry_cab.spec.libsonnet';
local rearAt(x) = local p = s.at([x, s.hubY]); [p[0], p[1], s.wheelZ];
{
  title: 'Jackknifed lorry cab',
  sites: [
    one('chassis', 'jackknifed_lorry_cab_chassis'),
    one('near_side', 'jackknifed_lorry_cab_near_side'),
    one('far_side', 'jackknifed_lorry_cab_far_side'),
    one('back', 'jackknifed_lorry_cab_back'),
    one('roof', 'jackknifed_lorry_cab_roof'),
    one('windscreen_frame', 'jackknifed_lorry_cab_windscreen_frame'),
    one('nose', 'jackknifed_lorry_cab_nose'),
    one('earth', 'jackknifed_lorry_cab_earth'),
    one('bumper', 'jackknifed_lorry_cab_bumper'),
    one('near_door', 'jackknifed_lorry_cab_near_door'),
    one('stacks', 'jackknifed_lorry_cab_stacks'),
    one('fuel_tank', 'jackknifed_lorry_cab_fuel_tank'),
    one('seat_frames', 'jackknifed_lorry_cab_seat_frames'),
    one('dash', 'jackknifed_lorry_cab_dash'),
    one('loose_wheel', 'jackknifed_lorry_cab_loose_wheel', [-0.35, 0, 2.5]),
    one('jammed_wheel', 'jackknifed_lorry_cab_jammed_wheel', [2.15, s.wheelR + 0.01, -1.42]),
  ]
  + pair('first_axle_wheel', 'jackknifed_lorry_cab_rear_wheel', rearAt(s.rearAxles[0]))
  + pair('last_axle_wheel', 'jackknifed_lorry_cab_rear_wheel', rearAt(s.rearAxles[1])),
  overlaps: [
    site.overlap('back', 'fuel_tank', 0.048,
      'The crushed cab back is pressed against the fuel tank.'),
    site.overlap('chassis', 'back', 0.05,
      'The crushed cab back is pressed down onto the chassis floor.'),
    site.overlap('chassis', 'earth', 0.063,
      'The chassis is bedded in the heap of earth the cab ploughed into.'),
    site.overlap('chassis', 'far_side', 0.06,
      'The crushed cab wall is pressed down onto the chassis floor.'),
    site.overlap('chassis', 'first_axle_wheel_far', 0.102,
      'The wheel is left on the axle the wreck chassis draws, so the axle runs into the rim.'),
    site.overlap('chassis', 'first_axle_wheel_near', 0.102,
      'The wheel is left on the axle the wreck chassis draws, so the axle runs into the rim.'),
    site.overlap('chassis', 'last_axle_wheel_far', 0.102,
      'The wheel is left on the axle the wreck chassis draws, so the axle runs into the rim.'),
    site.overlap('chassis', 'last_axle_wheel_near', 0.102,
      'The wheel is left on the axle the wreck chassis draws, so the axle runs into the rim.'),
    site.overlap('chassis', 'near_side', 0.06,
      'The crushed cab wall is pressed down onto the chassis floor.'),
    site.overlap('chassis', 'nose', 0.044,
      'The crushed nose wing is pressed down onto the chassis floor.'),
    site.overlap('chassis', 'windscreen_frame', 0.04,
      'The crushed windscreen frame is pressed down onto the chassis floor.'),
    site.overlap('earth', 'bumper', 0.125,
      'The heap of earth the cab ploughed into is piled up around the bumper.'),
    site.overlap('near_side', 'fuel_tank', 0.05,
      'The crushed cab wall is pressed against the fuel tank.'),
    site.overlap('nose', 'bumper', 0.125,
      'The crushed nose is folded back over the bumper.'),
    site.overlap('nose', 'earth', 0.093,
      'The crushed nose is buried in the heap of earth it ploughed into.'),
    site.overlap('nose', 'jammed_wheel', 0.093,
      'The crushed nose wing is pushed down onto the jammed wheel.'),
    site.overlap('windscreen_frame', 'earth', 0.048,
      'The windscreen frame is buried in the heap of earth the cab ploughed into.'),
  ],
}
