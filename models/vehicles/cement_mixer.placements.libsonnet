local site = import 'site.libsonnet';
{
  title: 'Cement mixer',
  // The drum and its frames take the place of the tipper's tub.
  sites: site.adjust(
    (import 'tipper_truck.placements.libsonnet').sites,
    drop=['subframe', 'tub_floor', 'tub_front', 'tailgate', 'tip_ram', 'tub_side_near', 'tub_side_far'],
    add=[
      site.one('subframe', 'cement_mixer_subframe'),
      site.one('drive', 'cement_mixer_drive'),
      site.one('rear_frame', 'cement_mixer_rear_frame'),
      site.one('drum', 'cement_mixer_drum'),
      site.one('hopper', 'cement_mixer_hopper'),
      site.one('chute', 'cement_mixer_chute'),
      site.one('platform', 'cement_mixer_platform'),
      site.one('water_tank', 'cement_mixer_water_tank'),
    ] + site.pair('roller_stand', 'cement_mixer_roller_stand'),
  ),
  unjudged: [
    site.unjudged('dashboard', 'radiator', 0.06,
      'The lower piece of tipper_truck_dashboard runs into the core piece of radiator_truck.'),
    site.unjudged('drive', 'drum', 0.238,
      'The pedestal piece of cement_mixer_drive runs into the band_0 piece of cement_mixer_drum.'),
    site.unjudged('drum', 'hopper', 0.058,
      'The band_14 piece of cement_mixer_drum runs into the wall_fore piece of cement_mixer_hopper.'),
    site.unjudged('drum', 'water_tank', 0.035,
      'The band_2 piece of cement_mixer_drum runs into the tank piece of cement_mixer_water_tank.'),
    site.unjudged('gearbox', 'drive', 0.09,
      'The case piece of gearbox_heavy runs into the foot piece of cement_mixer_drive.'),
    site.unjudged('gearbox', 'exhaust', 0.06,
      'The case piece of gearbox_heavy runs into the pipe piece of exhaust_long.'),
    site.unjudged('rear_frame', 'drum', 0.058,
      'The head piece of cement_mixer_rear_frame runs into the band_14 piece of cement_mixer_drum.'),
    site.unjudged('subframe', 'drive', 0.12,
      'The runner_near piece of cement_mixer_subframe runs into the foot piece of cement_mixer_drive.'),
    site.unjudged('subframe', 'roller_stand_far', 0.058,
      'The guard_beam piece of cement_mixer_subframe runs into the foot_far piece of cement_mixer_roller_stand.'),
    site.unjudged('subframe', 'roller_stand_near', 0.058,
      'The guard_beam piece of cement_mixer_subframe runs into the foot piece of cement_mixer_roller_stand.'),
  ],
}
