// Metres in the shipped model frame. Origins are placement datums, not bounding-box centres.
{
  bay: 2,
  storey: 3,
  timber: 0.2,
  plaster: 0.16,
  floor: 0.2,
  roofHalfSpan: 2,
  roofRise: 2,
  eave: 0.3,
  roofThickness: 0.12,
  verge: 0.3,
  grain: 0.02,
  door: { halfWidth: 0.6, height: 2.2, jamb: 0.12, clearance: 0.04 },
  window: { halfWidth: 0.4, bottom: 1, top: 2.2, frame: 0.12 },
}
