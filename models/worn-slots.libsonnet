// The body slot (models/TAXONOMY.md) a worn shell covers, by the segment its id ends in; the segments are
// packages/thing-authoring-tool/worn-taxonomy.libsonnet's `segments`.
{
  body: 'torso',
  upper: 'arms',
  fore: 'arms',
  palm: 'hands',
  fingers: 'hands',
  thumb: 'hands',
  pelvis: 'legs',
  thigh: 'legs',
  shin: 'legs',
  foot: 'feet',
  shaft: 'feet',
}
