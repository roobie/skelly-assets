// Shared by every patch, so a one-shot means the same strike, envelope and noise everywhere.

// Not stdfaust.lib, so that `no` and `pm` here can be the seeded ones; a patch needing another library adds its
// prefix here.
ba = library("basics.lib");
de = library("delays.lib");
en = library("envelopes.lib");
fi = library("filters.lib");
ma = library("maths.lib");
os = library("oscillators.lib");
ro = library("routes.lib");
si = library("signals.lib");

// Drawn by the renderer like a setting, so each seed gets its own noise instead of every render replaying the one
// stream noises.lib always starts from.
noiseSeed = int(hslider("noise seed [noise:seed]", 0, 0, 65535, 1));
// Odd, because the generator only keeps its full period with an odd increment.
stream = library("noises.lib")._noise_env(2 * noiseSeed + 1);
// Every noise noises.lib makes, and so every exciter and breath in physmodels.lib, comes from the seeded stream.
no = library("noises.lib")[
  noise = stream.noise;
  multirandom(N) = stream.multirandom(N);
  multinoise(N) = stream.multinoise(N);
  noises(N, i) = stream.noises(N, i);
];
pm = library("physmodels.lib")[no = no;];

// A patch is struck once, at the first sample, so an offline render needs no gate timing from the host.
strike = 1 - 1';

seconds = ba.time / ma.SR;

clamp01(x) = max(0, min(1, x));

// Exponential, so the fall is the time to -60 dB and the sound ends in silence within rise + fall.
riseFall(rise, fall) = clamp01(seconds / max(rise, 1 / ma.SR)) * exp(-6.9078 * max(seconds - rise, 0) / fall);

// Above this a resonator aliases or turns unstable, whatever a slider asks for.
audible(f) = min(f, 0.45 * ma.SR);

// A short filtered noise burst: the contact of a hit, softer as `hardness` falls.
contact(hardness) = no.noise * riseFall(0.0002, 0.004) : fi.lowpass(2, hardness);

// A mode's time to -60 dB in a material whose internal friction (tan phi) is `loss`. Decay shrinks as frequency
// rises, and how fast it shrinks is what tells wood and bone from glass and metal.
frictionT60(loss, f) = 6.9078 / (ma.PI * f * loss);
