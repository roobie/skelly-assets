{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      // Every module here is a CLI run by path or a module the showcase (`site/`, outside this package) or skelly
      // imports, so each is an entry and its exports are a surface whose consumers knip cannot see.
      "entry": ["*.mjs", "test/**/*.test.mjs"],
      "project": ["*.{mjs,ts}", "jsonnet/**/*.mjs", "test/**/*.mjs"],
      // tsconfig.json maps three to its types for the showcase, so knip reads the tests' runtime imports of three as
      // imports of the types.
      "ignoreDependencies": ["three"],
      "ignoreUnresolved": [
        // The skin check imports the showcase's modules in the browser, from the server that serves `site/`.
        "/clearance.mjs",
        "/skin.mjs"
      ]
    },
    "packages/mobgen": {
      // The script of `stress.html`, the Vite build's second page; knip reads only `index.html` for scripts.
      "entry": ["src/viewer/stress.ts"]
    },
    "packages/shader-lab": {
      // The dev server imports the lab's server by a computed URL so it reloads on edit; see `vite.config.ts`.
      "entry": ["server/labServer.ts"]
    },
    "packages/thing-authoring-tool": {
      // Run by hand to write the skin fixture's exports; see `README.md`.
      "entry": ["test/export-skin-fixture.ts"]
    },
    "packages/vehicle-authoring-tool": {
      // The dev server imports the endpoints by a computed URL; see `vite.config.ts`, `vehicleEndpoints`.
      "entry": ["server/vehicleApi.mjs"]
    }
  }
}
