    "knip": "knip",
    "workflows:lint": "node actionlint/lint.mjs"
  },
  "dependencies": {
    "three": "^0.186.0",
    "valibot": "^1.5.0",
    "wasm-media-encoders": "0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@skelly/thing-core": "*",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "knip": "6.34.0",
    "playwright": "1.64.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0"
  }
}
