{
  "name": "skelly-assets-tools",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "workspaces": [
    "packages/construct",
    "packages/thing-core",
    "packages/thing-export",
    "packages/mobgen",
    "packages/impact-synth",
    "packages/thing-authoring-tool",
    "packages/tool-ui",
