{
  "name": "mobgen",
  "private": true,
  "license": "EUPL-1.2",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../sources.mjs",
    "build": "tsc && vite build",
    "pretypecheck": "node ../../sources.mjs",
    "typecheck": "tsc && tsc -p tsconfig.core.json",
    "pretest": "node ../../sources.mjs",
    "test": "vitest run",
    "test:sweeps": "MOBGEN_SWEEPS=1 vitest run",
    "generate": "node src/cli/generate.ts",
    "stats": "node src/cli/stats.ts",
    "view": "node src/cli/view.ts",
    "bench": "node src/cli/bench.ts"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
