{
  "name": "broken-ar15-sight-height",
  "description": "An A2 rifle with the taller flat-top front sight base under the carry handle's rear sight.",
  "expect": ["ar15-sight-height"],
  "root": "lower",
  "parts": {
    "lower": { "family": "ar15-lower" },
    "upper": { "family": "ar15-upper", "params": { "top": "carry-handle" } },
    "barrel": { "family": "ar15-barrel", "params": { "length": "20-rifle" } },
    "front-sight-base": { "family": "ar15-front-sight-base", "params": { "height": "flat-top" } },
    "handguard": { "family": "ar15-handguard-drop-in", "params": { "gas": "rifle" } },
    "flash-hider": { "family": "ar15-flash-hider" },
    "receiver-extension": { "family": "ar15-receiver-extension", "params": { "buffer": "rifle" } },
    "stock": { "family": "ar15-stock", "params": { "style": "a2" } },
    "grip": { "family": "ar15-grip" },
    "magazine": { "family": "magazine", "params": { "length": "M", "profile": "stanag-straight" } }
  },
  "connections": [
    { "from": "lower.ar-upper", "to": "upper.ar-upper" },
    { "from": "lower.receiver-extension", "to": "receiver-extension.lower" },
    { "from": "receiver-extension.stock", "to": "stock.front" },
    { "from": "lower.grip", "to": "grip.top" },
    { "from": "lower.magazine", "to": "magazine.top" },
    { "from": "upper.barrel", "to": "barrel.rear" },
    { "from": "upper.barrel-nut", "to": "handguard.barrel-nut" },
    { "from": "barrel.gas-block", "to": "front-sight-base.barrel" },
    { "from": "front-sight-base.handguard-cap", "to": "handguard.handguard-cap" },
    { "from": "barrel.muzzle", "to": "flash-hider.base" }
  ]
}
